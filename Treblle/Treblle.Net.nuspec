<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>Treblle.Net</id>
    <version>2.0.1</version>
    <title>Treblle.Net</title>
    <authors>Treblle</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/Treblle/treblle-net</projectUrl>
    <repository type="git" url="https://github.com/Treblle/treblle-net.git" branch="master"/>
    <description>Treblle makes it super easy to understand what's going on with your APIs and the apps that use them.</description>
    <releaseNotes>
v2.0.1:
- Fixed compiler warnings (CS0114, CS0472, CS1998)
- Improved code quality and build stability

v2.0.0:
- Fixed masking system initialization - maskers now load correctly from executing assembly
- Fixed AdditionalFieldsToMask configuration - now supports simple format (field names only)
- Fixed EmailMasker - now properly masks local part while keeping domain visible (e.g., ****@example.com)
- Improved masker type resolution - now uses IStringMasker interface for correct method dispatch
- Enhanced debug logging throughout masking system
    </releaseNotes>
    <icon>resources\TreblleIcon.png</icon>
    <readme>docs\README.md</readme>
    <copyright>Copyright 2021, Treblle Limited</copyright>
  </metadata>
  <files>
    <file src="resources\TreblleIcon.png" target="resources\" />
	<file src="bin\Release\Treblle.Net.dll" target="lib\net462\" />
	<file src="bin\Release\Treblle.Net.pdb" target="lib\net462\" />
    <file src="..\README.md" target="docs\" />
  </files>
</package>